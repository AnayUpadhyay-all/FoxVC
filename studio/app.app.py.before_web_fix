        self.root = root
        self.documents = []
        self.active_doc_idx = -1
        self.project_dir = None
        self.is_result_expanded = False
        self.is_running = False
        self.is_waiting_for_input = False
        self.input_queue = queue.Queue()

        self._init_window()
        self._setup_theme()
        self._build_header()
        self._build_workspace()
        self._build_context_menus()
        self._bind_events()

        if initial_file and os.path.exists(initial_file):
            if os.path.isdir(initial_file):
                self.open_folder_path(os.path.abspath(initial_file))
            else:
                self.open_file_path(os.path.abspath(initial_file))
        else:
            self.new_file()

