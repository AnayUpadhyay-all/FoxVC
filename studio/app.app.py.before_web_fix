    def _build_context_menus(self):
        menu_kwargs = {
            "tearoff": 0, "bg": "#1C1917", "fg": "#E0D6CC",
            "activebackground": self.c_orange_main, "activeforeground": "#FFFFFF",
            "disabledforeground": "#5C544C", "bd": 1, "font": ("DejaVu Sans", 9)
        }
        self.editor_menu = tk.Menu(self.root, **menu_kwargs)
        self.editor_menu.add_command(label="Cut", accelerator="Ctrl+X", command=lambda: self.editor.event_generate("<<Cut>>"))
        self.editor_menu.add_command(label="Copy", accelerator="Ctrl+C", command=lambda: self.editor.event_generate("<<Copy>>"))
        self.editor_menu.add_command(label="Paste", accelerator="Ctrl+V", command=lambda: self.editor.event_generate("<<Paste>>"))
        self.editor_menu.add_separator()
        self.editor_menu.add_command(label="Select All", accelerator="Ctrl+A", command=self._menu_select_all)

        self.editor.bind("<Button-3>", lambda e: self.editor_menu.tk_popup(e.x_root, e.y_root))

    def _bind_events(self):
        self.editor.bind("<KeyRelease>", self._on_key_release)
        self.editor.bind("<MouseWheel>", lambda e: self.root.after_idle(self.lines.redraw))
        self.root.bind("<Control-n>", lambda e: self.new_file())
        self.root.bind("<Control-o>", lambda e: self.open_file_dialog())
        self.root.bind("<Control-O>", lambda e: self.open_folder_dialog())
        self.root.bind("<Control-s>", lambda e: self.save_file())
        self.root.bind("<Control-S>", lambda e: self.save_file_as())
        self.root.bind("<Control-w>", lambda e: self.close_active_tab())
        self.root.bind("<Control-a>", lambda e: self._menu_select_all())
        self.root.bind("<F5>", lambda e: self.run_code())
        self.root.bind("<F6>", lambda e: self.run_diagnostics())
        self.root.bind("<F7>", lambda e: self.launch_web_app())
        self.root.protocol("WM_DELETE_WINDOW", self.on_close)

    def _menu_select_all(self):
        self.editor.tag_add(tk.SEL, "1.0", tk.END)
        self.editor.mark_set(tk.INSERT, "1.0")

    def _on_scroll_y(self, *args):
        self.editor.yview(*args)
        self.lines.redraw()

    def _on_key_release(self, event=None):
        doc = self.get_active_doc()
        if doc:
            doc.is_modified = True
            doc.content = self.editor.get("1.0", tk.END)
        self.update_tab_bar()
        self.update_doc_title()
        self.lines.redraw()
        self.highlight_syntax()

    def get_active_doc(self):
        if 0 <= self.active_doc_idx < len(self.documents):
            return self.documents[self.active_doc_idx]
        return None

    def update_doc_title(self):
        doc = self.get_active_doc()
        if doc:
            dirty = "● " if doc.is_modified else ""
            fmt = detect_source_format(doc.filepath)
            self.root.title(f"🦊 {dirty}{doc.title} [{fmt}] — FoxVC Studio")
            self.doc_tag.config(text=f"🦊 {dirty}{doc.title} ({fmt})")
        else:
            self.root.title(f"FoxVC Studio (v{FOXVC_STUDIO_VERSION})")
            self.doc_tag.config(text="• Ready")

    def update_tab_bar(self):
        for widget in self.tab_bar_frame.winfo_children():
            widget.destroy()

        for idx, doc in enumerate(self.documents):
            is_active = (idx == self.active_doc_idx)
            tab_bg = "#23201D" if is_active else "#161514"
            tab_fg = "#FFFFFF" if is_active else "#8E8379"

            tab_btn = tk.Frame(self.tab_bar_frame, bg=tab_bg, padx=6, pady=2)
            tab_btn.pack(side=tk.LEFT, fill=tk.Y, padx=(0, 2))

            dirty = "● " if doc.is_modified else ""
            lbl = tk.Label(tab_btn, text=f"{dirty}{doc.title}", bg=tab_bg, fg=tab_fg, font=("DejaVu Sans", 9))
            lbl.pack(side=tk.LEFT, padx=(4, 6))
            lbl.bind("<Button-1>", lambda e, i=idx: self.switch_tab(i))

            close_btn = tk.Label(tab_btn, text="✕", bg=tab_bg, fg="#A3968A", font=("DejaVu Sans", 8))
            close_btn.pack(side=tk.RIGHT, padx=(2, 4))
            close_btn.bind("<Button-1>", lambda e, i=idx: self.close_tab(i))
            close_btn.bind("<Enter>", lambda e, w=close_btn: w.config(fg="#FF7A00"))
            close_btn.bind("<Leave>", lambda e, w=close_btn: w.config(fg="#A3968A"))

    def switch_tab(self, idx):
        if idx < 0 or idx >= len(self.documents):
            return
        cur_doc = self.get_active_doc()
        if cur_doc:
            cur_doc.content = self.editor.get("1.0", tk.END)

        self.active_doc_idx = idx
        new_doc = self.documents[idx]

        self.editor.delete("1.0", tk.END)
        self.editor.insert("1.0", new_doc.content)
        self.update_tab_bar()
        self.update_doc_title()
        self.lines.redraw()
        self.highlight_syntax()

    def close_tab(self, idx):
        if idx < 0 or idx >= len(self.documents):
            return
        doc = self.documents[idx]
        if doc.is_modified:
            ans = messagebox.askyesnocancel("Unsaved Changes", f"Save changes to {doc.title} before closing?")
            if ans is True:
                self.switch_tab(idx)
                if not self.save_file():
                    return
            elif ans is None:
                return

        del self.documents[idx]
        if not self.documents:
            self.new_file()
        else:
            new_idx = max(0, idx - 1)
            self.switch_tab(new_idx)

    def close_active_tab(self):
        self.close_tab(self.active_doc_idx)

    def new_file(self):
        # Untitled default: plain clean document ready to be named on save
        doc = DocumentTab(filepath=None, title="untitled.fox", content="")
        self.documents.append(doc)
        self.switch_tab(len(self.documents) - 1)
        self.status_note.config(text="New document ready (untitled.fox).")

    def open_file_dialog(self):
        filepaths = filedialog.askopenfilenames(
            filetypes=[
                ("All FoxVC Files", "*.fox;*.fweb;*.fskin;*.flogic"),
                ("FoxVC Files (*.fox)", "*.fox"),
                ("FoxVC Web (*.fweb)", "*.fweb"),
                ("FoxVC Skin (*.fskin)", "*.fskin"),
                ("FoxVC Logic (*.flogic)", "*.flogic"),
                ("All Files", "*.*")
            ]
        )
        if filepaths:
            for fp in filepaths:
                self.open_file_path(os.path.abspath(fp))

    def open_file_path(self, filepath):
        for idx, doc in enumerate(self.documents):
            if doc.filepath and os.path.abspath(doc.filepath) == os.path.abspath(filepath):
                self.switch_tab(idx)
                return

        try:
            with open(filepath, "r", encoding="utf-8") as f:
                code = f.read()
            doc = DocumentTab(filepath=filepath, title=os.path.basename(filepath), content=code)
            self.documents.append(doc)
            self.switch_tab(len(self.documents) - 1)
            self.status_note.config(text=f"Loaded: {os.path.basename(filepath)}")
        except Exception as e:
            messagebox.showerror("FoxVC Studio", f"Could not load file:\n{e}")

    def open_folder_dialog(self):
        folder = filedialog.askdirectory(title="Select FoxVC Project Folder")
        if folder:
            self.open_folder_path(os.path.abspath(folder))

    def open_folder_path(self, folderpath):
        self.project_dir = folderpath
        self.side_title.config(text=f"📁 {os.path.basename(folderpath).upper()}")
        self._populate_tree(folderpath)
        self.status_note.config(text=f"Project folder opened: {os.path.basename(folderpath)}")

    def _populate_tree(self, folderpath):
        self.file_tree.delete(*self.file_tree.get_children())
        self._append_tree_nodes("", folderpath)

    def _append_tree_nodes(self, parent, path):
        try:
            items = sorted(os.listdir(path))
        except Exception:
            return

        # Show directories first, then files
        dirs = [i for i in items if os.path.isdir(os.path.join(path, i)) and not i.startswith(".")]
        files = [i for i in items if os.path.isfile(os.path.join(path, i)) and not i.startswith(".")]

        for d in dirs:
            full_p = os.path.join(path, d)
            node = self.file_tree.insert(parent, "end", text=f"📁 {d}", values=[full_p, "dir"], open=False)
            self._append_tree_nodes(node, full_p)

        for f in files:
            full_p = os.path.join(path, f)
            icon = "🦊" if f.endswith((".fox", ".fweb", ".fskin", ".flogic")) else "📄"
            self.file_tree.insert(parent, "end", text=f"{icon} {f}", values=[full_p, "file"])

    def _on_tree_item_clicked(self, event=None):
        selected = self.file_tree.selection()
        if not selected:
            return
        item_vals = self.file_tree.item(selected[0], "values")
        if item_vals and len(item_vals) >= 2:
            fpath, ftype = item_vals[0], item_vals[1]
            if ftype == "file":
                self.open_file_path(fpath)

    def save_file(self):
        doc = self.get_active_doc()
        if not doc:
            return False
        if not doc.filepath:
            return self.save_file_as()
        try:
            doc.content = self.editor.get("1.0", tk.END)
            with open(doc.filepath, "w", encoding="utf-8") as f:
                f.write(doc.content.rstrip() + "\n")
            doc.is_modified = False
            self.update_tab_bar()
            self.update_doc_title()
            self.status_note.config(text=f"Saved: {doc.title}")
            return True
        except Exception as e:
            messagebox.showerror("FoxVC Studio", f"Could not save file:\n{e}")
            return False

    def save_file_as(self):
        doc = self.get_active_doc()
        if not doc:
            return False
        filepath = filedialog.asksaveasfilename(
            initialfile=doc.title,
            filetypes=[
                ("FoxVC Files (*.fox)", "*.fox"),
                ("FoxVC Web (*.fweb)", "*.fweb"),
                ("FoxVC Skin (*.fskin)", "*.fskin"),
                ("FoxVC Logic (*.flogic)", "*.flogic"),
                ("All Files", "*.*")
            ]
        )
        if not filepath:
            return False
        doc.filepath = os.path.abspath(filepath)
        doc.title = os.path.basename(filepath)
        return self.save_file()

    def highlight_syntax(self):
        self.editor.tag_remove("keyword", "1.0", tk.END)
        self.editor.tag_remove("string", "1.0", tk.END)
        content = self.editor.get("1.0", tk.END)
        lines = content.split("\n")

        for line_idx, line in enumerate(lines, start=1):
            for kw in ("say", "ask", "element", "set", "add", "bind", "mount", "show", "render", "use", "skin", "apply", "action", "state"):
                idx = 0
                kw_len = len(kw)
                while idx < len(line):
                    pos = line.find(kw, idx)
                    if pos == -1:
                        break
                    is_start = (pos == 0 or not line[pos-1].isalnum())
                    is_end = (pos + kw_len >= len(line) or not line[pos+kw_len].isalnum())
                    if is_start and is_end:
                        self.editor.tag_add("keyword", f"{line_idx}.{pos}", f"{line_idx}.{pos+kw_len}")
                    idx = pos + kw_len

            in_string = False
            start_col = 0
            for col_idx, char in enumerate(line):
                if char == '"':
                    if not in_string:
                        in_string = True
                        start_col = col_idx
                    else:
                        in_string = False
                        self.editor.tag_add("string", f"{line_idx}.{start_col}", f"{line_idx}.{col_idx+1}")

    def clear_result(self):
        self.is_waiting_for_input = False
        self.input_bar.pack_forget()
        self.result_text.config(state=tk.NORMAL)
        self.result_text.delete("1.0", tk.END)
        self.result_text.config(state=tk.DISABLED)

    def _submit_native_input(self):
        if not self.is_waiting_for_input:
            return
        self.is_waiting_for_input = False
        val = self.input_entry.get()
        self.input_entry.delete(0, tk.END)
        self.input_queue.put(val)

    def _request_input_from_thread(self, prompt: str) -> str:
        def show_input_ui():
            self.result_text.config(state=tk.NORMAL)
            self.result_text.insert(tk.END, f" 🦊 {prompt}\n", "summary_header")
            self.result_text.config(state=tk.DISABLED)
            self.input_bar.pack(side=tk.BOTTOM, fill=tk.X, padx=6, pady=4, before=self.result_body)
            self.input_entry.focus_set()
            self.is_waiting_for_input = True

        self.root.after(0, show_input_ui)
        val = self.input_queue.get()
        self.root.after(0, lambda: self.input_bar.pack_forget())
        return val

    def run_code(self):
        if self.is_running:
            return
        doc = self.get_active_doc()
        if not doc:
            return
        self.is_running = True
        self.btn_run.config(state=tk.DISABLED)
        self.clear_result()
        self.status_note.config(text=f"Executing {doc.title}...")

        source = self.editor.get("1.0", tk.END)
        fpath = doc.filepath

        def worker():
            res = run_foxvc(source, input_source=self._request_input_from_thread, file_path=fpath)
            self.root.after(0, lambda: self._on_execution_complete(res))

        threading.Thread(target=worker, daemon=True).start()

    def run_diagnostics(self):
        if self.is_running:
            return
        doc = self.get_active_doc()
        if not doc:
            return
        self.is_running = True
        self.btn_diag.config(state=tk.DISABLED)
        self.clear_result()
        self.status_note.config(text=f"Running diagnostics on {doc.title}...")

        source = self.editor.get("1.0", tk.END)
        fpath = doc.filepath

        def worker():
            res = run_foxvc_diagnostic(source, input_source=self._request_input_from_thread, file_path=fpath)
            self.root.after(0, lambda: self._on_diagnostic_complete(res))

        threading.Thread(target=worker, daemon=True).start()

    def launch_web_app(self):
        doc = self.get_active_doc()
        if not doc:
            return
        source = self.editor.get("1.0", tk.END)
        fpath = doc.filepath
        res = run_foxvc(source, file_path=fpath)
        if res.success and res.is_web_app:
            url = FoxWebRuntime.launch(res.web_app)
            self.status_note.config(text=f"Mounted at {url}")
        elif not res.success:
            self._on_execution_complete(res)
            messagebox.showerror("FoxVC Diagnostic Error", f"Cannot launch WebApplication:\n{res.error}")
        else:
            messagebox.showinfo("FoxVC Web Runtime", "No WebApplication detected. Construct or mount an element to launch.")

    def _on_execution_complete(self, result):
        self.is_running = False
        self.btn_run.config(state=tk.NORMAL)

        self.result_text.config(state=tk.NORMAL)
        if result.success:
            self.result_text.insert(tk.END, " FINISHED ", "badge_success")
            self.result_text.insert(tk.END, "  Program executed cleanly.\n\n", "meta_info")
            if result.output:
                self.result_text.insert(tk.END, result.output + "\n", "output_content")
            if result.is_web_app:
                self.result_text.insert(tk.END, "\n WEB APP ", "badge_web")
                self.result_text.insert(tk.END, f"  Live WebApplication mounted (<{result.web_app.root.kind}>). Press '🌐 LAUNCH APP (F7)' to view.\n", "output_content")
            self.status_note.config(text="Execution finished.")
        else:
            self.result_text.insert(tk.END, " DIAGNOSTIC ", "badge_error")
            self.result_text.insert(tk.END, f"  Execution halted.\n\n{result.error}\n", "error_content")
            self.status_note.config(text="Execution halted on diagnostic error.")

        self.result_text.see(tk.END)
        self.result_text.config(state=tk.DISABLED)

    def _on_diagnostic_complete(self, result):
        self.is_running = False
        self.btn_diag.config(state=tk.NORMAL)

        self.result_text.config(state=tk.NORMAL)
        self.result_text.insert(tk.END, " FOXVC DIAGNOSTIC EXECUTION REPORT \n\n", "summary_header")

        for r in result.statement_reports:
            line_str = str(r.line).zfill(2)
            if r.status == StatementStatus.PASS:
                self.result_text.insert(tk.END, f"[{line_str}] ", "meta_info")
                self.result_text.insert(tk.END, " PASS ", "badge_pass")
                if r.variable:
                    self.result_text.insert(tk.END, f"  {r.variable} = {r.value}\n", "output_content")
                elif r.output:
                    self.result_text.insert(tk.END, f"  {r.output}\n", "output_content")
                else:
                    self.result_text.insert(tk.END, f"  {r.source}\n", "meta_info")
            elif r.status == StatementStatus.FAIL:
                self.result_text.insert(tk.END, f"[{line_str}] ", "meta_info")
                self.result_text.insert(tk.END, " FAIL ", "badge_fail")
                self.result_text.insert(tk.END, f"  {r.source} -> {r.diagnostic.message}\n", "error_content")
            elif r.status == StatementStatus.BLOCKED:
                self.result_text.insert(tk.END, f"[{line_str}] ", "meta_info")
                self.result_text.insert(tk.END, " BLOCKED ", "badge_blocked")
                self.result_text.insert(tk.END, f"  {r.source} -> {r.blocked_reason}\n", "blocked_content")

        if result.summary:
            s = result.summary
            self.result_text.insert(tk.END, "\n--- Diagnostic Summary ---\n", "summary_header")
            self.result_text.insert(tk.END, f"Passed: {s.passed}  |  Failed: {s.failed}  |  Blocked: {s.blocked}\n", "meta_info")

        self.result_text.see(tk.END)
        self.result_text.config(state=tk.DISABLED)

    def toggle_result_size(self):
        self.is_result_expanded = not self.is_result_expanded
        self.result_card.configure(height=380 if self.is_result_expanded else 230)
        self.btn_expand.config(text="↕ Normal" if self.is_result_expanded else "↕ Expand")

    def on_close(self):
        for idx, doc in enumerate(self.documents):
            if doc.is_modified:
                ans = messagebox.askyesnocancel("Unsaved Changes", f"Save changes to {doc.title} before exiting?")
                if ans is True:
                    self.switch_tab(idx)
                    self.save_file()
                elif ans is None:
                    return
        self.root.destroy()

def main():
    root = tk.Tk()
    initial_file = sys.argv[1] if len(sys.argv) > 1 else None
    app = FoxVCStudio(root, initial_file=initial_file)
    root.mainloop()

if __name__ == "__main__":
    main()
