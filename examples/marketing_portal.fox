# ==============================================================================
# FoxVC Official Marketing & Product Showcase Web Server
# Ultra-Premium Developer Platform Showcase
# ==============================================================================

say "=================================================="
say "   🦊 Starting FoxVC Flagship Showcase Server     "
say "=================================================="

# 1. Initialize In-Memory Database for Live Interactive Submissions
db = dbOpen(":memory:")
dbExecute(db, "CREATE TABLE showcase_likes (id TEXT PRIMARY KEY, user_agent TEXT, timestamp REAL)")
dbExecute(db, "CREATE TABLE guestbook (id TEXT PRIMARY KEY, name TEXT, message TEXT, timestamp REAL)")

# Seed sample guestbook entries
dbExecute(db, "INSERT INTO guestbook VALUES ('1', 'Linus T.', '15.5KB standalone binaries with SQLite is seriously impressive.', ?)", [time() - 3600])
dbExecute(db, "INSERT INTO guestbook VALUES ('2', 'Sarah Dev', '0.8ms startup time blows away our Node serverless cold-starts.', ?)", [time() - 1800])
say "✓ SQLite In-Memory Database Initialized & Seeded."

# 2. Read Premium HTML Payload
html_content = readFile("examples/marketing_portal.html")
say "✓ Loaded Flagship HTML Presentation Payload."

# 3. Create HTTP Server
srv = httpServer(8080, "0.0.0.0")

# Route: GET /
act handle_home(req)
    emit httpResponse(html_content, 200, pack { content_type: "text/html; charset=utf-8" })

httpRoute(srv, "GET", "/", handle_home)

# Route: GET /health
act handle_health(req)
    emit httpResponse(pack { status: "healthy", version: "1.0.0", timestamp: time() })

httpRoute(srv, "GET", "/health", handle_health)

# Route: GET /api/system
act handle_system(req)
    emit httpResponse(pack { platform: platform(), cpus: cpuCount(), timestamp: time() })

httpRoute(srv, "GET", "/api/system", handle_system)

# Route: GET /api/guestbook
act handle_get_guestbook(req)
    rows = dbQuery(db, "SELECT id, name, message, timestamp FROM guestbook ORDER BY timestamp DESC LIMIT 20")
    emit httpResponse(rows)

httpRoute(srv, "GET", "/api/guestbook", handle_get_guestbook)

# Route: POST /api/guestbook
act handle_post_guestbook(req)
    body = req.json
    name = "Anonymous Dev"
    msg = ""
    pick body != blank
        pick body.name != blank
            name = body.name
        pick body.message != blank
            msg = body.message
    gid = uuid()
    dbExecute(db, "INSERT INTO guestbook VALUES (?, ?, ?, ?)", [gid, name, msg, time()])
    emit httpResponse(pack { success: aye, id: gid })

httpRoute(srv, "POST", "/api/guestbook", handle_post_guestbook)

# 4. Launch Flagship Server
httpStart(srv)
say "=================================================="
say "🚀 FOXVC PREMIER SHOWCASE SERVER RUNNING!"
say "   Local URL:  http://127.0.0.1:8080"
say "   LAN URL:    http://localhost:8080"
say "=================================================="

# Infinite non-blocking dispatch loop
spin srv.running == 1
    sleep(1.0)
