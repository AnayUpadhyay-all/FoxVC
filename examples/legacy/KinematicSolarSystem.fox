# FoxVC Semantic Temporal Space Workload (v0.5.0)
# High Complexity Solar System: Hierarchical Kinematic Orbits & Harmonic Pulses

space KinematicSolarSystem
    background "#05070D"

    # 1. Central Star (Pulsing Core)
    entity Sun
        form circle
        diameter 95
        fill "#FF8A00"
        stroke "#FFA94D" thickness 2
        glow 30
        pulse min 0.94 max 1.06 period 3

    # 2. Inner System Orbits
    entity Mercury
        form circle
        diameter 12
        fill "#94A3B8"
        around Sun distance 85 period 3.2

    entity Venus
        form circle
        diameter 20
        fill "#F59E0B"
        around Sun distance 130 period 6.5

    # 3. Earth & Moon Hierarchical Kinematic System
    entity Earth
        form circle
        diameter 24
        fill "#38BDF8"
        stroke "#0284C7" thickness 1
        around Sun distance 190 period 10.0

    entity Moon
        form circle
        diameter 8
        fill "#E2E8F0"
        around Earth distance 32 period 1.8

    # 4. Outer System
    entity Mars
        form circle
        diameter 16
        fill "#EF4444"
        around Sun distance 255 period 18.8

    entity Jupiter
        form circle
        diameter 50
        fill "#D97706"
        stroke "#B45309" thickness 2
        around Sun distance 340 period 32.0

    # 5. Jupiter Galilean Satellites (Hierarchical Kinematic Chain)
    replicate 4 of entity JovianMoon
        form circle
        diameter 6
        fill "#FDE68A"
        around Jupiter distance 45 distributed radial phase 30 period 2.5

    # 6. High-Speed Inner Asteroid Belt
    replicate 24 of entity Asteroid
        form circle
        diameter 3
        fill "#64748B"
        opacity 0.75
        around Sun distance 220 distributed radial phase 15 period 14.0
