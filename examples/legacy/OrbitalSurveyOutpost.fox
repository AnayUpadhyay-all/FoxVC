# FoxVC 2D Relational Entity Space Workload (v0.4.0)

space OrbitalSurveyPlatform
    background "#06080F"

    replicate 50 of entity Star
        form circle
        diameter 3
        fill "#E2E8F0"
        opacity 0.6
        distributed field spread 650

    entity CommandHull
        form circle
        diameter 130
        fill "#172033"
        stroke "#FF7A00" thickness 3
        anchor nose at north
        anchor drive at south
        anchor port_dock at west
        anchor stbd_dock at east

    entity ReactorCore
        form circle
        diameter 45
        inside CommandHull at center
        fill "#FF7A00"
        glow 20

    entity SensorCanopy
        form arc
        radius 35
        span 180
        anchored_to CommandHull.nose at south
        fill "#38BDF8"
        stroke "#0284C7" thickness 2
        opacity 0.85
        anchor antenna_mount at north

    entity PortSolarWing
        form rect
        size 180 by 50
        anchored_to CommandHull.port_dock at east offset -4, 0
        fill "#0F172A"
        stroke "#334155" thickness 1

        replicate 6 of entity PhotoCell
            form rect
            size 22 by 38
            fill "#1E3A8A"
            stroke "#60A5FA" thickness 1
            distributed linear along x within PortSolarWing padding 6

    entity StarboardSolarWing
        form rect
        size 180 by 50
        anchored_to CommandHull.stbd_dock at west offset 4, 0
        fill "#0F172A"
        stroke "#334155" thickness 1

        replicate 6 of entity PhotoCell
            form rect
            size 22 by 38
            fill "#1E3A8A"
            stroke "#60A5FA" thickness 1
            distributed linear along x within StarboardSolarWing padding 6

    entity PrimaryRadarDish
        form circle
        diameter 32
        fill "#1E293B"
        stroke "#38BDF8" thickness 2
        beside SensorCanopy at north spacing 55
        anchor feed at south

    connect StrutAlpha from CommandHull.nose to PrimaryRadarDish.feed
        stroke "#64748B" thickness 2

    replicate 3 of entity EscortDrone
        form polygon [0, -12, 10, 10, -10, 10]
        fill "#F59E0B"
        stroke "#D97706" thickness 1
        around CommandHull distance 240 distributed radial phase 45
