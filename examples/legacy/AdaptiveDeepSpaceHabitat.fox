# FoxVC Adaptive 2D Stress Test Workload (v0.6.0)
# Evaluates LIGHT, COMPLEX, and EXTREME execution profiles under identical semantics.

space DeepSpaceHabitatNexus
    background "#04060A"

    # 1. Atmospheric Ambient Particles (Decorative tier for Light profile adaptation)
    replicate 40 of entity AmbientDust
        form circle
        diameter 2
        fill "#94A3B8"
        opacity 0.4
        tier "decorative"
        distributed field spread 600

    # 2. Central Fusion Core (Pulsing Reactor)
    entity FusionCore
        form circle
        diameter 90
        fill "#FF7A00"
        stroke "#FFA94D" thickness 2
        glow 35
        pulse min 0.9 max 1.15 period 2.4
        anchor north_hub at north
        anchor south_hub at south
        anchor port_bay at west
        anchor stbd_bay at east

    # 3. Inner Counter-Rotating Centrifugal Habitat Ring
    entity InnerHabitatRing
        form circle
        diameter 170
        fill "none"
        stroke "#38BDF8" thickness 3
        inside FusionCore at center
        spin period 8.0

    # 4. Outer Defense & Docking Ring
    entity OuterDefenseRing
        form circle
        diameter 250
        fill "none"
        stroke "#1E293B" thickness 4
        inside FusionCore at center
        spin period -14.0

    # 5. Port & Starboard Solar Power Arrays
    entity PortSolarWing
        form rect
        size 160 by 45
        anchored_to FusionCore.port_bay at east offset -4, 0
        fill "#0F172A"
        stroke "#334155" thickness 1

        replicate 5 of entity PhotoCell
            form rect
            size 20 by 35
            fill "#1E3A8A"
            stroke "#60A5FA" thickness 1
            distributed linear along x within PortSolarWing padding 6

    entity StarboardSolarWing
        form rect
        size 160 by 45
        anchored_to FusionCore.stbd_bay at west offset 4, 0
        fill "#0F172A"
        stroke "#334155" thickness 1

        replicate 5 of entity PhotoCell
            form rect
            size 20 by 35
            fill "#1E3A8A"
            stroke "#60A5FA" thickness 1
            distributed linear along x within StarboardSolarWing padding 6

    # 6. Deep Space Communications Tower
    entity CommTower
        form circle
        diameter 28
        fill "#1E293B"
        stroke "#38BDF8" thickness 2
        beside FusionCore at north spacing 60
        anchor receiver at south

    connect SupportPylon from FusionCore.north_hub to CommTower.receiver
        stroke "#64748B" thickness 2

    # 7. Patrol Frigate Fleet with Escort Drone Kinematic Chains
    entity PatrolFrigate
        form polygon [0, -14, 12, 12, -12, 12]
        fill "#10B981"
        stroke "#059669" thickness 1
        around FusionCore distance 230 period 16.0
        anchor escort_slot at center

    entity EscortInterceptor
        form circle
        diameter 10
        fill "#F59E0B"
        around PatrolFrigate distance 35 period 2.5

    # 8. Secondary Outer Defense Swarm
    replicate 3 of entity DefenseSentry
        form circle
        diameter 14
        fill "#EF4444"
        around FusionCore distance 310 distributed radial phase 60 period 28.0
