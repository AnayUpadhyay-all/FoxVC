# FoxVC Heavy Industrial Machining Complex
load "motion.kinematics" as kin
load "spatial.expansion" as spat
load "visual.fx" as fx

space IndustrialPowerhouse
    background "#06080D"
    day_cycle 45

    # 1. Structural Engine Bed
    entity MachineBed
        form rect
        size 1100 by 520
        fill "#0D1117"
        stroke "#1E293B" thickness 4
        anchor crank_bearing at north offset -280, 80

    # 2. Main Drive Crankshaft
    entity CrankFlywheel
        form circle
        diameter 210
        fill "#161E2E"
        stroke "#38BDF8" thickness 4
        glow 15
        inside MachineBed at center offset -280, 80
        spin period 4.0
        anchor pin_left at west
        anchor pin_right at east
        anchor counterbalance_top at north

    entity CrankPinJournalLeft
        form circle
        diameter 28
        fill "#F59E0B"
        stroke "#D97706" thickness 2
        anchored_to CrankFlywheel.pin_left at center

    entity CrankPinJournalRight
        form circle
        diameter 28
        fill "#F59E0B"
        stroke "#D97706" thickness 2
        anchored_to CrankFlywheel.pin_right at center

    # 3. Horizontal Opposed Pistons
    entity CylinderBlockPort
        form rect
        size 240 by 95
        fill "#111827"
        stroke "#475569" thickness 3
        beside CrankFlywheel direction west spacing 85

    entity PistonCrownPort
        form rect
        size 70 by 80
        fill "#1E3A8A"
        stroke "#60A5FA" thickness 2
        inside CylinderBlockPort at center
        apply PistonCrownPort spat.linear_track span 90.0 period 4.0 axis "x"
        anchor gudgeon_pin at east

    entity CylinderBlockStbd
        form rect
        size 240 by 95
        fill "#111827"
        stroke "#475569" thickness 3
        beside CrankFlywheel direction east spacing 85

    entity PistonCrownStbd
        form rect
        size 70 by 80
        fill "#1E3A8A"
        stroke "#60A5FA" thickness 2
        inside CylinderBlockStbd at center
        apply PistonCrownStbd spat.linear_track span -90.0 period 4.0 axis "x"
        anchor gudgeon_pin at west

    # 4. Planetary Reduction Gear Assembly
    entity RingGearHousing
        form circle
        diameter 240
        fill "none"
        stroke "#334155" thickness 8
        inside MachineBed at center offset 160, 40

    entity SunGear
        form circle
        diameter 70
        fill "#1E293B"
        stroke "#F59E0B" thickness 3
        glow 12
        anchored_to RingGearHousing.center at center
        spin period -1.333

    replicate 4 of entity PlanetGear
        form circle
        diameter 50
        fill "#0F172A"
        stroke "#38BDF8" thickness 2
        around SunGear distance 75 distributed radial phase 0 period 4.0

    entity CarrierArmPlate
        form rect
        size 160 by 24
        fill "#242C3D"
        stroke "#64748B" thickness 2
        inside RingGearHousing at center
        spin period 4.0
        anchor power_takeoff at east

    # 5. Rocker Beam
    entity RockerFulcrumPillar
        form rect
        size 30 by 160
        fill "#1E293B"
        stroke "#475569" thickness 2
        inside MachineBed at center offset -120, -110
        anchor pivot at north

    entity RockerWalkingBeam
        form polygon [-130, -12, 130, -6, 120, 10, -120, 10]
        fill "#334155"
        stroke "#94A3B8" thickness 2
        anchored_to RockerFulcrumPillar.pivot at south offset 0, -10
        apply RockerWalkingBeam spat.wobble inclination 14.0 period 4.0
        anchor pushrod_conn at west
        anchor valve_actuator at east

    # 6. High-Pressure Steam Vessel
    entity SteamExpansionVessel
        form circle
        diameter 65
        fill "#78350F"
        stroke "#F59E0B" thickness 3
        glow 25
        inside MachineBed at center offset 360, -190
        pulse min 0.94 max 1.08 period 1.0
        anchor exhaust_port at east

    entity ValveStrobeIndicator
        form circle
        diameter 22
        fill "#EF4444"
        stroke "#991B1B" thickness 2
        anchored_to SteamExpansionVessel.exhaust_port at west offset 30, 0
        apply ValveStrobeIndicator fx.opacity_wave period 0.5 min 0.2 max 1.0

    # 7. Dynamic Mechanical Connecting Rods
    connect PortConnectingRod from CrankPinJournalLeft.center to PistonCrownPort.gudgeon_pin
        stroke "#E2E8F0" thickness 6

    connect StbdConnectingRod from CrankPinJournalRight.center to PistonCrownStbd.gudgeon_pin
        stroke "#E2E8F0" thickness 6

    connect OverheadPushRod from CrankFlywheel.counterbalance_top to RockerWalkingBeam.pushrod_conn
        stroke "#38BDF8" thickness 3

    connect ValveStemLinkage from RockerWalkingBeam.valve_actuator to SteamExpansionVessel.center
        stroke "#F59E0B" thickness 3
