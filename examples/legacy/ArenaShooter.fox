# FoxVC 2D Arena Combat Game
# Powered by Panda Game Library

load "panda"

space ArenaSector
    background "#030712"

    entity Interceptor
        form polygon [-22, -16, 26, 0, -22, 16, -12, 0]
        fill "#38BDF8"
        stroke "#0284C7" thickness 2
        aim "pointer"
        weapon "plasma"
        velocity 520
        camera "focus"

    entity SentryDrone
        form circle
        diameter 16
        fill "#F59E0B"
        around Interceptor distance 54 period 2.0

    entity DeflectorShield
        form circle
        diameter 76
        fill "none"
        stroke "#38BDF8" thickness 1
        opacity 0.4
        around Interceptor distance 0 period 0
        pulse min 0.95 max 1.05 period 1.5

