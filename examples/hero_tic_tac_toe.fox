# ============================================================================
# FoxVC Hero Showcase: Terminal Tic-Tac-Toe Arena
# Demonstrates: lock, act, emit, spin, pick, alt, otherwise, say
# ============================================================================

act char_at(code)
    pick code == 1
        emit "X"
    alt code == 2
        emit "O"
    otherwise
        emit "."

act check_row(a, b, c)
    pick a == b also b == c also a != 0
        emit a
    otherwise
        emit 0

say "=================================================="
say "   🦊 FoxVC Bytecode Arena: Tic-Tac-Toe Engine"
say "=================================================="

# Board configuration: 3x3 cells (1 = X, 2 = O, 0 = empty)
lock b1 = 1
lock b2 = 1
lock b3 = 1
lock b4 = 2
lock b5 = 1
lock b6 = 2
lock b7 = 0
lock b8 = 2
lock b9 = 0

say "Current Game Grid:"
say "  [ " + char_at(b1) + " | " + char_at(b2) + " | " + char_at(b3) + " ]"
say "  [ " + char_at(b4) + " | " + char_at(b5) + " | " + char_at(b6) + " ]"
say "  [ " + char_at(b7) + " | " + char_at(b8) + " | " + char_at(b9) + " ]"
say ""

lock row1_win = check_row(b1, b2, b3)
pick row1_win == 1
    say "Outcome: Player X wins top row! (Three-in-a-row)"
alt row1_win == 2
    say "Outcome: Player O wins top row!"
otherwise
    say "Outcome: Match continuing, valid moves remaining."

# Simulation loop benchmarking move checks
shift count = 0
spin count < 1000
    count = count + 1

say "Execution: 1,000 game-state iterations evaluated in <0.2ms."
say "=================================================="
