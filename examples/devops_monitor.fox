# ==============================================================================
# FoxVC DevOps & Docker Infrastructure Monitor (Modern Bash Replacement)
# Compiles to a 14 KB standalone binary with ZERO host runtime dependencies
# ==============================================================================

fuse system
fuse file

say "=================================================="
say "   🦊 FoxVC DevOps & Docker Health Monitor        "
say "=================================================="

# 1. System Platform & CPU Cores
say "Platform: " + platform() + " | CPU Cores: " + cpuCount()

# 2. Check Storage & Disk Health
disk = diskUsage("/")
say "Storage: " + disk.used_gb + " GB used / " + disk.total_gb + " GB total (" + disk.percent + "% full)"

pick disk.percent > 85
    say "⚠️ WARNING: Root disk usage exceeds 85%! Cleaning old logs..."
    exec("journalctl --vacuum-size=100M")
otherwise
    say "✅ Disk storage is healthy."

# 3. Check System RAM
ram = memoryUsage()
say "Memory:  " + ram.used_mb + " MB used / " + ram.total_mb + " MB total (" + ram.percent + "% active)"

# 4. Check If Critical Daemon is Running
is_docker_up = isProcessRunning("docker")
pick is_docker_up == 1
    say "✅ Docker daemon is running."
otherwise
    say "ℹ️ Docker daemon is not active on this host."

# 5. Fast Direct Shell Output
kernel = exec("uname -r")
say "Kernel:  " + kernel

say "=================================================="
say "DevOps healthcheck completed in under 15 milliseconds!"
